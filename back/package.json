{
  "name": "crescendo-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"test/unit/**/*.test.ts\" test/architecture.test.ts",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.23.1",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
