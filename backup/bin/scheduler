#!/bin/sh
# Proceso del servicio `backup`: un respaldo diario a BACKUP_TIME (zona BACKUP_TZ) y uno al
# iniciar si el último exitoso tiene más de 24 h. Los fallos se reintentan cada hora.
set -eu
. /usr/local/lib/crescendo-backup/lib.sh

trap 'log "detenido"; exit 0' TERM INT

# Sin clave pública no hay nada que hacer: queda en espera (no reinicia en bucle).
if [ -z "${BACKUP_AGE_RECIPIENT:-}" ]; then
  log "desactivado: falta BACKUP_AGE_RECIPIENT (ver sección Respaldos del README)"
  while :; do sleep 3600 & wait $!; done
fi

BACKUP_TIME=${BACKUP_TIME:-23:00}
export TZ=${BACKUP_TZ:-America/Santiago}
[ -f "/usr/share/zoneinfo/$TZ" ] || fail "BACKUP_TZ inválida: $TZ"
echo "$BACKUP_TIME" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || fail "BACKUP_TIME inválido (HH:MM): $BACKUP_TIME"
h=$(echo "$BACKUP_TIME" | cut -c1-2); m=$(echo "$BACKUP_TIME" | cut -c4-5)
target=$(( ${h#0} * 60 + ${m#0} )) # sin el 0 inicial: "08" sería octal

minutes_now() { h=$(date +%H); m=$(date +%M); echo $(( ${h#0} * 60 + ${m#0} )); }

mkdir -p "$STATE_DIR/state"
retry_after=0

run_backup() {
  if backup-now; then
    retry_after=0
    # Si ya pasó la hora de hoy, este respaldo cuenta como el diario.
    [ "$(minutes_now)" -lt "$target" ] || date +%F >"$STATE_DIR/state/daily"
  else
    retry_after=$(( $(date +%s) + 3600 ))
    warn "respaldo fallido; reintento en 1 h"
  fi
}

last=$(cat "$STATE_DIR/state/last-success" 2>/dev/null || echo 0)
if [ $(( $(date +%s) - last )) -ge 86400 ]; then
  log "último respaldo con más de 24 h: respaldando al iniciar"
  run_backup
fi
log "próximo respaldo diario a las $BACKUP_TIME ($TZ)"

while :; do
  if [ "$(minutes_now)" -ge "$target" ] && [ "$(cat "$STATE_DIR/state/daily" 2>/dev/null || true)" != "$(date +%F)" ] &&
    [ "$(date +%s)" -ge "$retry_after" ]; then
    run_backup
  fi
  sleep 60 & wait $!
done
