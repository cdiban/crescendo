# Copiar a .env (no versionado) y cambiar las contraseñas.

# Postgres (servicio db)
POSTGRES_USER=crescendo
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=crescendo

# API (servicio api). La contraseña debe coincidir con POSTGRES_PASSWORD (codificada para URL si tiene caracteres especiales).
DATABASE_URL=postgres://crescendo:cambia-esta-clave@db:5432/crescendo
APP_ORIGIN=http://localhost:8080
SESSION_TTL_HOURS=168
# true: la cookie lleva Secure (Chrome/Firefox la aceptan en http://localhost; Safari no).
COOKIE_SECURE=true

# Worker (servicio worker): tipos de cambio desde mindicador.cl y precios desde Yahoo Finance.
# FX_BACKFILL_FROM=2024-01-01
# FX_SYNC_INTERVAL_MINUTES=360
# Cotizaciones con el mercado abierto (minutos).
# QUOTES_INTERVAL_MINUTES=5

# Web (servicio web). Interfaz donde se publica :8080. Por defecto 127.0.0.1 (sólo este equipo).
# Usar 0.0.0.0 sólo cuando se quiera exponer a la red local u otras redes.
# WEB_BIND=127.0.0.1
